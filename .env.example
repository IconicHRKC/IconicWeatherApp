# Copy this file to .env for local testing (do not commit the real .env)

# From your Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number, SMS-capable, in E.164 format
TWILIO_SMS_FROM=+18165551234

# Optional - only after your WhatsApp sender + template are approved.
# Sandbox number for testing: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Where alerts get sent
ALERT_TO_PHONE=+19137872654

# The public URL where this app is deployed (put in the alert text)
DASHBOARD_URL=https://iconic-storm-watch.onrender.com

# How often to check NOAA/NWS for new reports
POLL_INTERVAL_MINUTES=10
